---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card/index.astro";
import IntroCard from "../components/IntroCard.astro";
import TimeZone from "../components/TimeZoneCard.astro";
import AboutMe from "../components/AboutMe.astro";
import Now from "../components/Now.astro";
import Globe from "../components/Globe";
---

<!-- Google tag (gtag.js) -->
<script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-3L21ZFG7DE"></script>
<script type="text/partytown">
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-3L21ZFG7DE');
</script>

<script>
  import { stagger, timeline, type TimelineDefinition } from "motion";
  import { easeOutExpo, loaderAnimation } from "../lib/constants";

  const cards = document.querySelectorAll(".card");
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  // With reduced motion the cards simply appear; only the loader fades.
  const sequence = prefersReducedMotion
    ? [loaderAnimation]
    : [
        loaderAnimation,
        [
          cards,
          { opacity: [0, 1], y: [16, 0] },
          {
            at: "-0.35",
            duration: 0.5,
            delay: stagger(0.06),
            easing: easeOutExpo,
          },
        ],
      ];

  timeline(sequence as TimelineDefinition);
</script>

<Layout
  title="Arnit Sinha"
  description="Software developer with strong focus on AI based programs"
>
  <main
    class="text-white m-auto p-2 grid gap-2 max-w-6xl relative w-full grid-cols-1 sm:p-4 sm:gap-3 sm:grid-cols-2 md:gap-3 md:p-6 lg:h-screen lg:grid-rows-9 lg:grid-cols-4 lg:gap-4 lg:max-h-full lg:overflow-hidden"
  >
    <IntroCard />
    <AboutMe />
    <TimeZone />
    <Card
      colSpan="col-span-1 sm:col-span-1"
      rowSpan="row-span-1 lg:row-span-2"
      title="Blog"
      href="/blog"
    />
    <Card
      colSpan="col-span-1 sm:col-span-2"
      rowSpan="row-span-1 lg:row-span-2"
      class="min-h-[220px] lg:min-h-0"
      title="Countries I visited"
      href="travel"
      colorText="text-neutral-900"
    >
      <div class="h-full w-full absolute inset-0 -z-10">
        <Globe client:load />
      </div>
    </Card>
    <Card
      colSpan="col-span-1 sm:col-span-1"
      rowSpan="row-span-1 lg:row-span-2"
      title="Contact"
      href="mailto:hey@arnitsinha.com"
    >
    </Card>
    <Now />
    <Card colSpan="col-span-1 sm:col-span-2 lg:col-span-4" rowSpan="row-span-1">
      <div class="flex items-center justify-center h-full">
        <p class="text-xs text-center">
          © 2026 · Crafted with ♥️ by Arnit Sinha
        </p>
      </div>
    </Card>
  </main>
</Layout>
