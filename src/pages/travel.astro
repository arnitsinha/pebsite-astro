---
import Globe from "../components/Globe";
import BasicLayout from "../layouts/BasicLayout.astro";
---

<!-- Google tag (gtag.js) -->
<script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-3L21ZFG7DE"></script>
<script type="text/partytown">
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-3L21ZFG7DE');
</script>

<script>
  import { timeline, type TimelineDefinition } from "motion";

  const sequence = [
    [
      ".loaderRef",
      { opacity: [1, 0], pointerEvents: "none" },
      { easing: "ease-out" },
    ],
  ];

  timeline(sequence as TimelineDefinition);
</script>

<BasicLayout
  title="Arnit Sinha - Countries Visited"
  description="A 3D globe showing countries that I have visited so far"
  page="travel"

>
  <a
    href="/"
    class="text-white fixed z-10 bg-neutral-900 hover:bg-neutral-800 top-4 left-4 px-4 py-2 border-1 border-solid border-purple-500 rounded-lg"
    >Back</a
  >

  <div class="w-full h-[100dvh] flex justify-center items-center">
    <Globe client:load interactive={true} />
  </div>
</BasicLayout>

<!-- The globe is dragged directly, so the page itself must not scroll or
     bounce underneath it. Scoped to this page only. -->
<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }
</style>
